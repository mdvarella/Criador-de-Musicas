# =============================================================================
# Minha Musica IA - variaveis de ambiente
# Copie para .env.local e preencha. NUNCA versione segredos reais.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
# URL publica completa (usada em links de entrega, webhooks e back_urls).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nome comercial exibido em toda a interface (trocavel sem alterar codigo).
NEXT_PUBLIC_BRAND_NAME=Minha Musica IA
NEXT_PUBLIC_BRAND_TAGLINE=Transforme sua historia em uma musica unica.
# Contato exibido nas paginas legais e de suporte.
NEXT_PUBLIC_SUPPORT_EMAIL=contato@exemplo.com.br
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511999999999

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Ignora RLS. Jamais expor no browser.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado onde os audios sao armazenados.
SUPABASE_STORAGE_BUCKET=songs

# --- OpenAI (LLMProvider) ----------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# Opcional: endpoint compativel alternativo.
# OPENAI_BASE_URL=

# --- ElevenLabs Music (MusicGenerationProvider) ------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Mercado Pago (PaymentProvider) ------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# --- Notificacoes ------------------------------------------------------------
# console | resend  (whatsapp fica preparado, mas nao habilitado no MVP)
NOTIFICATION_EMAIL_PROVIDER=console
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=Minha Musica IA <nao-responda@exemplo.com.br>

# --- Seguranca ---------------------------------------------------------------
# Segredo usado para assinar URLs temporarias de audio (>= 32 caracteres).
MEDIA_SIGNING_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Segredo exigido no header Authorization do worker de jobs (cron da Vercel).
JOBS_WORKER_SECRET=troque-por-um-segredo-longo-e-aleatorio
# E-mails autorizados no /admin, separados por virgula.
ADMIN_ALLOWED_EMAILS=admin@exemplo.com.br

# --- Analytics (opcional, tudo desligado por padrao) -------------------------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Modo de execucao --------------------------------------------------------
# Quando true, LLM e musica usam providers MOCK (nao gastam credito).
# Util em desenvolvimento e nos testes end-to-end locais.
USE_MOCK_PROVIDERS=true
